    <string name="watches_empty_title">You are not following any offices yet</string>
    <string name="watches_empty_body">Choose every office you could travel to. The app checks the police\'s appointment booking regularly and alerts you when an appointment opens up.</string>
    <string name="bg_title">Make sure alerts get through</string>
    <string name="bg_intro">The app checks the police\'s booking site in the background. Battery saving and deep sleep can stop or delay the check, so you hear about free appointments too late.</string>
    <string name="bg_notifications_off">Off – you won\'t get any alerts</string>
    <string name="bg_turn_on">Turn on</string>
    <string name="bg_running">Battery optimisation</string>
    <string name="bg_running_limited">On – Android may put the app in deep sleep and stop the check</string>
    <string name="bg_running_ok">Off – the check may run in the background</string>
    <string name="bg_allow">Turn off</string>
    <string name="bg_power_save">Battery Saver</string>
    <string name="bg_power_save_on">On – checks wait until Battery Saver is turned off</string>
    <string name="bg_power_save_off">Off</string>
    <string name="bg_open">Open</string>
    <string name="bg_samsung_title">Samsung: sleeping apps</string>
    <string name="bg_samsung_body">Samsung can put apps to sleep or deep sleep, which stops the check completely. Open Battery → Background usage limits and add %1$s to the apps that never sleep. The names vary a little between versions.</string>
    <string name="bg_vendor_title">%1$s: extra battery savers</string>
    <string name="bg_vendor_body">%1$s phones often have their own settings that stop apps in the background, such as autostart or app sleeping. Open app info and allow background activity, or follow the guide for your phone.</string>
    <string name="bg_open_battery">Open battery</string>
    <string name="bg_open_app_info">Open app info</string>
    <string name="bg_guide">Guide</string>
    <string name="bg_hint_app_info">Choose “App battery usage” (or “Battery”), then “Unrestricted”.</string>
    <string name="bg_hint_list">Choose “All apps”, find %1$s and pick “Don’t optimise”.</string>
    <string name="bg_prompt_title">Let the app check in the background?</string>
    <string name="bg_prompt_body">To get an alert as soon as an earlier appointment opens up, Android has to let the app run in the background. On the next screen you can let the app skip battery optimisation. It uses very little power – the app only checks a few times an hour.</string>
