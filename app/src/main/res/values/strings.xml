    <string name="bg_samsung_title">Samsung: apper i hvilemodus</string>
    <string name="bg_samsung_body">Samsung kan legge apper i hvilemodus eller dyp hvilemodus, og da stopper sjekken helt. Åpne Batteri → Begrensninger for bakgrunnsbruk og legg %1$s blant appene som aldri skal i hvilemodus. Navnene varierer litt mellom versjoner.</string>
    <string name="bg_vendor_title">%1$s: egne strømsparere</string>
    <string name="bg_vendor_body">%1$s-telefoner har ofte egne innstillinger som stopper apper i bakgrunnen, for eksempel autostart eller apper i dvale. Åpne appinfo og tillat bakgrunnsaktivitet, eller følg veiledningen for telefonen din.</string>
